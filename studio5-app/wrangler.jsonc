{
  // Studio5 on your own Cloudflare account: the installable app (static assets) + the phone↔laptop relay.
  // Durable Objects (SQLite-backed) are available on the Workers Free plan.
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "studio5-app",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "PAIRING", "class_name": "Pairing" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room", "Pairing"] }
  ]
}
