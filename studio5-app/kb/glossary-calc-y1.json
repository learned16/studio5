[
  {"id":"g-calc-001","week":1,"en":"matrix","ar":"مصفوفة","def_en":"A matrix is a rectangular arrangement of entries in rows and columns.","def_ar":"المصفوفة ترتيب مستطيل لعناصر في صفوف وأعمدة.","example":"A = [1 2; 3 4]","status":"needs-check"},
  {"id":"g-calc-002","week":1,"en":"row","ar":"صف","def_en":"A row is a horizontal line of entries in a matrix.","def_ar":"الصف خط أفقي من العناصر داخل المصفوفة.","example":"[1 2 3] is one row.","status":"needs-check"},
  {"id":"g-calc-003","week":1,"en":"column","ar":"عمود","def_en":"A column is a vertical line of entries in a matrix.","def_ar":"العمود خط عمودي من العناصر داخل المصفوفة.","example":"[1; 2; 3] is one column.","status":"needs-check"},
  {"id":"g-calc-004","week":1,"en":"order of a matrix","ar":"رتبة المصفوفة","def_en":"The order of a matrix gives its number of rows followed by its number of columns.","def_ar":"رتبة المصفوفة تبيّن عدد صفوفها ثم عدد أعمدتها.","example":"A with 2 rows and 3 columns has order 2 × 3.","status":"needs-check"},
  {"id":"g-calc-005","week":1,"en":"square matrix","ar":"مصفوفة مربعة","def_en":"A square matrix has the same number of rows and columns.","def_ar":"المصفوفة المربعة لها العدد نفسه من الصفوف والأعمدة.","example":"[1 0; 0 1] is 2 × 2.","status":"needs-check"},
  {"id":"g-calc-006","week":1,"en":"rectangular matrix","ar":"مصفوفة مستطيلة","def_en":"A rectangular matrix has different numbers of rows and columns.","def_ar":"المصفوفة المستطيلة يختلف فيها عدد الصفوف عن عدد الأعمدة.","example":"[1 2 3; 4 5 6] is 2 × 3.","status":"needs-check"},
  {"id":"g-calc-007","week":1,"en":"zero matrix","ar":"مصفوفة صفرية","def_en":"A zero matrix is a matrix whose every entry is zero.","def_ar":"المصفوفة الصفرية مصفوفة تساوي جميع عناصرها صفراً.","example":"[0 0; 0 0]","status":"needs-check"},
  {"id":"g-calc-008","week":1,"en":"identity matrix","ar":"مصفوفة الوحدة","def_en":"An identity matrix is a square matrix with ones on its main diagonal and zeros elsewhere.","def_ar":"مصفوفة الوحدة مصفوفة مربعة عناصر قطرها الرئيس تساوي واحداً وبقية عناصرها تساوي صفراً.","example":"I₂ = [1 0; 0 1]","status":"needs-check"},
  {"id":"g-calc-009","week":1,"en":"scalar","ar":"عدد قياسي","def_en":"A scalar is a single number used to multiply every entry of a matrix.","def_ar":"العدد القياسي عدد واحد يُستخدم لضرب كل عنصر في المصفوفة.","example":"In 3A, 3 is a scalar.","status":"needs-check"},
  {"id":"g-calc-010","week":1,"en":"scalar multiplication","ar":"الضرب بعدد قياسي","def_en":"Scalar multiplication multiplies each entry of a matrix by the same number.","def_ar":"الضرب بعدد قياسي يعني ضرب كل عنصر في المصفوفة بالعدد نفسه.","example":"2[1 3; 4 5] = [2 6; 8 10]","status":"needs-check"},
  {"id":"g-calc-011","week":1,"en":"matrix addition","ar":"جمع المصفوفات","def_en":"Matrix addition adds corresponding entries of matrices with the same order.","def_ar":"جمع المصفوفات يجمع العناصر المتناظرة في مصفوفتين لهما الرتبة نفسها.","example":"[1 2; 3 4] + [0 1; 2 0] = [1 3; 5 4]","status":"needs-check"},
  {"id":"g-calc-012","week":1,"en":"matrix product","ar":"حاصل ضرب المصفوفتين","def_en":"A matrix product is defined when the first matrix's column count equals the second matrix's row count.","def_ar":"يُعرّف حاصل ضرب مصفوفتين عندما يساوي عدد أعمدة الأولى عدد صفوف الثانية.","example":"If A has order 2 × 3 and B has order 3 × 4, then AB has order 2 × 4.","status":"needs-check"},

  {"id":"g-calc-013","week":2,"en":"determinant","ar":"محدد","def_en":"A determinant is a number associated with a square matrix.","def_ar":"المحدد عدد يرتبط بمصفوفة مربعة.","example":"det([a b; c d]) = ad − bc","status":"needs-check"},
  {"id":"g-calc-014","week":2,"en":"minor","ar":"محدد صغرى","def_en":"The minor of an entry is the determinant left after deleting its row and column.","def_ar":"المحدد الصغرى لعنصر هو محدد المصفوفة الباقية بعد حذف صفه وعموده.","example":"For a₁₁ in a 3 × 3 matrix, delete row 1 and column 1.","status":"needs-check"},
  {"id":"g-calc-015","week":2,"en":"cofactor","ar":"معامل مرافق","def_en":"A cofactor is a minor multiplied by a sign determined by the entry's position.","def_ar":"المعامل المرافق هو المحدد الصغرى مضروباً بإشارة يحددها موضع العنصر.","example":"Cᵢⱼ = (−1)ⁱ⁺ʲ Mᵢⱼ","status":"needs-check"},
  {"id":"g-calc-016","week":2,"en":"adjugate matrix","ar":"المصفوفة المرافقة","def_en":"The adjugate matrix is the transpose of the matrix of cofactors.","def_ar":"المصفوفة المرافقة هي منقول مصفوفة المعاملات المرافقة.","example":"adj(A) = Cᵀ","status":"needs-check"},
  {"id":"g-calc-017","week":2,"en":"inverse matrix","ar":"المصفوفة المعكوسة","def_en":"The inverse matrix of A is a matrix that multiplies with A to give the identity matrix.","def_ar":"المصفوفة المعكوسة لـ A هي مصفوفة يكون حاصل ضربها في A مصفوفة الوحدة.","example":"A A⁻¹ = I","status":"needs-check"},
  {"id":"g-calc-018","week":2,"en":"invertible matrix","ar":"مصفوفة قابلة للعكس","def_en":"An invertible matrix is a square matrix that has an inverse.","def_ar":"المصفوفة القابلة للعكس مصفوفة مربعة لها معكوس.","example":"A is invertible when det(A) ≠ 0.","status":"needs-check"},
  {"id":"g-calc-019","week":2,"en":"singular matrix","ar":"مصفوفة منفردة","def_en":"A singular matrix is a square matrix whose determinant is zero.","def_ar":"المصفوفة المنفردة مصفوفة مربعة محددها يساوي صفراً.","example":"det(A) = 0 means A is singular.","status":"needs-check"},
  {"id":"g-calc-020","week":2,"en":"nonsingular matrix","ar":"مصفوفة غير منفردة","def_en":"A nonsingular matrix is a square matrix whose determinant is not zero.","def_ar":"المصفوفة غير المنفردة مصفوفة مربعة محددها لا يساوي صفراً.","example":"det(A) = 5 means A is nonsingular.","status":"needs-check"},
  {"id":"g-calc-021","week":2,"en":"main diagonal","ar":"القطر الرئيس","def_en":"The main diagonal runs from the upper-left entry to the lower-right entry of a square matrix.","def_ar":"القطر الرئيس يمتد من العنصر العلوي الأيسر إلى العنصر السفلي الأيمن في المصفوفة المربعة.","example":"The main diagonal of [1 2; 3 4] is 1, 4.","status":"needs-check"},
  {"id":"g-calc-022","week":2,"en":"determinant expansion","ar":"توسيع المحدد","def_en":"Determinant expansion expresses a determinant as a signed sum of entries times their minors.","def_ar":"توسيع المحدد يكتب المحدد كمجموع موقّع لعناصر مضروبة في محدداتها الصغرى.","example":"A 3 × 3 determinant can be expanded along its first row.","status":"needs-check"},

  {"id":"g-calc-023","week":3,"en":"linear equation","ar":"معادلة خطية","def_en":"A linear equation has variables only to the first power and no products between variables.","def_ar":"المعادلة الخطية لا تظهر متغيراتها إلا بأس واحد ولا تحتوي على حاصل ضرب بينها.","example":"2x + 3y = 7","status":"needs-check"},
  {"id":"g-calc-024","week":3,"en":"system of linear equations","ar":"نظام معادلات خطية","def_en":"A system of linear equations is a set of linear equations solved using the same variables.","def_ar":"نظام المعادلات الخطية مجموعة معادلات خطية تُحل باستخدام المتغيرات نفسها.","example":"2x + y = 5 and x − 3y = −8","status":"needs-check"},
  {"id":"g-calc-025","week":3,"en":"coefficient matrix","ar":"مصفوفة المعاملات","def_en":"The coefficient matrix contains the coefficients of the variables in a linear system.","def_ar":"مصفوفة المعاملات تحتوي على معاملات المتغيرات في النظام الخطي.","example":"For 2x + y = 5, x − 3y = −8, A = [2 1; 1 −3].","status":"needs-check"},
  {"id":"g-calc-026","week":3,"en":"augmented matrix","ar":"المصفوفة الموسعة","def_en":"An augmented matrix places the constants column beside the coefficient matrix.","def_ar":"المصفوفة الموسعة تضع عمود الثوابت بجانب مصفوفة المعاملات.","example":"[2 1 | 5; 1 −3 | −8]","status":"needs-check"},
  {"id":"g-calc-027","week":3,"en":"constants vector","ar":"متجه الثوابت","def_en":"The constants vector lists the right-hand-side values of a linear system in order.","def_ar":"متجه الثوابت يسرد قيم الطرف الأيمن للنظام الخطي بالترتيب.","example":"For the system above, b = [5; −8].","status":"needs-check"},
  {"id":"g-calc-028","week":3,"en":"solution of a system","ar":"حل النظام","def_en":"A solution of a system is a set of variable values that satisfies every equation in it.","def_ar":"حل النظام مجموعة قيم للمتغيرات تحقق جميع معادلاته.","example":"x = 1, y = 3 satisfies both equations above.","status":"needs-check"},
  {"id":"g-calc-029","week":3,"en":"unique solution","ar":"حل وحيد","def_en":"A unique solution is the single variable assignment that satisfies a system.","def_ar":"الحل الوحيد قيمة واحدة لكل متغير تحقق النظام ولا يشاركه فيها حل آخر.","example":"x = 1, y = 3","status":"needs-check"},
  {"id":"g-calc-030","week":3,"en":"Cramer's rule","ar":"قاعدة كرامر","def_en":"Cramer's rule solves a square linear system by dividing a replacement determinant by the coefficient determinant.","def_ar":"قاعدة كرامر تحل نظاماً خطياً مربعاً بقسمة محدد الاستبدال على محدد المعاملات.","example":"x = Δₓ / Δ when Δ ≠ 0.","status":"needs-check"},

  {"id":"g-calc-031","week":4,"en":"Cartesian plane","ar":"المستوى الإحداثي","def_en":"The Cartesian plane is a flat coordinate system formed by two perpendicular number axes.","def_ar":"المستوى الإحداثي نظام مستوٍ يتكون من محورين عدديين متعامدين.","example":"The point (2, 3) lies in the plane.","status":"needs-check"},
  {"id":"g-calc-032","week":4,"en":"coordinate axes","ar":"محورا الإحداثيات","def_en":"The coordinate axes are the horizontal x-axis and vertical y-axis in the plane.","def_ar":"محورا الإحداثيات هما المحور الأفقي x والمحور العمودي y في المستوى.","example":"They meet at (0, 0).","status":"needs-check"},
  {"id":"g-calc-033","week":4,"en":"origin","ar":"نقطة الأصل","def_en":"The origin is the point where the coordinate axes intersect.","def_ar":"نقطة الأصل هي النقطة التي يتقاطع عندها محورا الإحداثيات.","example":"The origin has coordinates (0, 0).","status":"needs-check"},
  {"id":"g-calc-034","week":4,"en":"ordered pair","ar":"زوج مرتب","def_en":"An ordered pair gives a point…2211 tokens truncated…ي قيمة الدالة التي تقترب منها عندما يقترب المدخل من النقطة بقيم أصغر.","example":"limₓ→₂⁻ f(x)","status":"needs-check"},
  {"id":"g-calc-059","week":7,"en":"right-hand limit","ar":"الغاية من اليمين","def_en":"The right-hand limit is the value a function approaches as its input nears a point from larger values.","def_ar":"الغاية من اليمين هي قيمة الدالة التي تقترب منها عندما يقترب المدخل من النقطة بقيم أكبر.","example":"limₓ→₂⁺ f(x)","status":"needs-check"},
  {"id":"g-calc-060","week":7,"en":"two-sided limit","ar":"الغاية الثنائية","def_en":"A two-sided limit exists when the left-hand and right-hand limits exist and are equal.","def_ar":"توجد الغاية الثنائية عندما توجد غايتا اليمين واليسار وتتساويان.","example":"limₓ→ₐ⁻ f(x) = limₓ→ₐ⁺ f(x)","status":"needs-check"},
  {"id":"g-calc-061","week":7,"en":"direct substitution","ar":"التعويض المباشر","def_en":"Direct substitution evaluates an expression by replacing its variable with the value it approaches.","def_ar":"التعويض المباشر يحسب التعبير باستبدال متغيره بالقيمة التي يقترب منها.","example":"limₓ→₂ (x + 1) = 2 + 1","status":"needs-check"},
  {"id":"g-calc-062","week":7,"en":"indeterminate form","ar":"صيغة غير محددة","def_en":"An indeterminate form is an expression such as 0/0 that does not determine a limit by itself.","def_ar":"الصيغة غير المحددة تعبير مثل 0/0 لا يحدد الغاية وحده.","example":"(x² − 4)/(x − 2) gives 0/0 at x = 2.","status":"needs-check"},
  {"id":"g-calc-063","week":7,"en":"factoring","ar":"التحليل إلى عوامل","def_en":"Factoring rewrites an expression as a product of simpler expressions.","def_ar":"التحليل إلى عوامل يعيد كتابة التعبير على صورة حاصل ضرب تعابير أبسط.","example":"x² − 4 = (x − 2)(x + 2)","status":"needs-check"},

  {"id":"g-calc-064","week":8,"en":"squeeze theorem","ar":"مبرهنة الحصر","def_en":"The squeeze theorem finds a limit by placing a function between two functions with the same limit.","def_ar":"تحدد مبرهنة الحصر غاية دالة بحصرها بين دالتين لهما الغاية نفسها.","example":"If g(x) ≤ f(x) ≤ h(x) and both outer limits are L, then f tends to L.","status":"needs-check"},
  {"id":"g-calc-065","week":8,"en":"lower bound","ar":"حد أدنى","def_en":"A lower bound is a value that a function does not go below within a stated interval.","def_ar":"الحد الأدنى قيمة لا تنخفض الدالة عنها ضمن فترة محددة.","example":"−1 ≤ sin x","status":"needs-check"},
  {"id":"g-calc-066","week":8,"en":"upper bound","ar":"حد أعلى","def_en":"An upper bound is a value that a function does not exceed within a stated interval.","def_ar":"الحد الأعلى قيمة لا تتجاوزها الدالة ضمن فترة محددة.","example":"sin x ≤ 1","status":"needs-check"},
  {"id":"g-calc-067","week":8,"en":"bounded between","ar":"محصور بين","def_en":"A function is bounded between two functions when its values stay above one and below the other.","def_ar":"تكون الدالة محصورة بين دالتين عندما تبقى قيمها أعلى من الأولى وأدنى من الثانية.","example":"−x² ≤ x² sin(1/x) ≤ x²","status":"needs-check"},
  {"id":"g-calc-068","week":8,"en":"radian","ar":"راديان","def_en":"A radian is an angle measure equal to the central angle that subtends an arc as long as the radius.","def_ar":"الراديان قياس زاوية مركزية تقابل قوساً طوله يساوي نصف قطر الدائرة.","example":"π radians = 180°","status":"needs-check"},
  {"id":"g-calc-069","week":8,"en":"radian measure","ar":"قياس بالراديان","def_en":"Radian measure expresses an angle as the ratio of its subtended arc length to the circle's radius.","def_ar":"القياس بالراديان يعبّر عن الزاوية بنسبة طول القوس الذي تقابله إلى نصف قطر الدائرة.","example":"θ = s/r","status":"needs-check"},
  {"id":"g-calc-070","week":8,"en":"unit circle","ar":"دائرة الوحدة","def_en":"The unit circle is a circle centered at the origin with radius one.","def_ar":"دائرة الوحدة دائرة مركزها نقطة الأصل ونصف قطرها واحد.","example":"x² + y² = 1","status":"needs-check"},
  {"id":"g-calc-071","week":8,"en":"sine function","ar":"دالة الجيب","def_en":"The sine function assigns to an angle the vertical coordinate of its point on the unit circle.","def_ar":"دالة الجيب تربط الزاوية بالإحداثي العمودي لنقطتها على دائرة الوحدة.","example":"sin(π/2) = 1","status":"needs-check"},
  {"id":"g-calc-072","week":8,"en":"standard sine limit","ar":"غاية الجيب القياسية","def_en":"The standard sine limit states that sin θ divided by θ approaches one as θ approaches zero in radians.","def_ar":"تنص غاية الجيب القياسية على أن نسبة sin θ إلى θ تقترب من واحد عندما تقترب θ من الصفر بالراديان.","example":"limθ→₀ sin θ / θ = 1","status":"needs-check"},

  {"id":"g-calc-073","week":9,"en":"trigonometric limit","ar":"غاية مثلثية","def_en":"A trigonometric limit studies the value approached by an expression containing trigonometric functions.","def_ar":"الغاية المثلثية تدرس القيمة التي يقترب منها تعبير يحتوي على دوال مثلثية.","example":"limₓ→₀ sin x / x","status":"needs-check"},
  {"id":"g-calc-074","week":9,"en":"sine-over-angle limit","ar":"غاية الجيب على الزاوية","def_en":"The sine-over-angle limit is the limit of sin θ divided by θ as θ approaches zero in radians.","def_ar":"غاية الجيب على الزاوية هي غاية sin θ مقسوماً على θ عندما تقترب θ من الصفر بالراديان.","example":"limθ→₀ sin θ / θ = 1","status":"needs-check"},
  {"id":"g-calc-075","week":9,"en":"tangent function","ar":"دالة الظل","def_en":"The tangent function is the ratio of sine to cosine wherever cosine is not zero.","def_ar":"دالة الظل هي نسبة الجيب إلى جيب التمام حيثما لا يساوي جيب التمام صفراً.","example":"tan θ = sin θ / cos θ","status":"needs-check"},
  {"id":"g-calc-076","week":9,"en":"tangent limit","ar":"غاية الظل","def_en":"The tangent limit near zero follows from the sine-over-angle limit and cos θ approaching one.","def_ar":"تُستنتج غاية الظل قرب الصفر من غاية الجيب على الزاوية ومن اقتراب cos θ من واحد.","example":"limθ→₀ tan θ / θ = 1","status":"needs-check"},
  {"id":"g-calc-077","week":9,"en":"angle in radians","ar":"زاوية مقاسة بالراديان","def_en":"An angle in radians is measured using the ratio of its arc length to the radius.","def_ar":"الزاوية المقاسة بالراديان تُحدَّد بنسبة طول قوسها إلى نصف القطر.","example":"π/2 radians = 90°","status":"needs-check"},
  {"id":"g-calc-078","week":9,"en":"trigonometric identity","ar":"متطابقة مثلثية","def_en":"A trigonometric identity is an equation between trigonometric expressions that holds for every allowed angle.","def_ar":"المتطابقة المثلثية معادلة بين تعابير مثلثية تصح لكل زاوية مسموحة.","example":"sin² θ + cos² θ = 1","status":"needs-check"},
  {"id":"g-calc-079","week":9,"en":"small-angle limit","ar":"غاية الزاوية الصغيرة","def_en":"A small-angle limit describes the value approached by a trigonometric expression as its angle nears zero.","def_ar":"غاية الزاوية الصغيرة تصف القيمة التي يقترب منها تعبير مثلثي عندما تقترب زاويته من الصفر.","example":"For small θ in radians, sin θ / θ approaches 1.","status":"needs-check"},

  {"id":"g-calc-080","week":10,"en":"limit at infinity","ar":"غاية عند اللانهاية","def_en":"A limit at infinity describes the value a function approaches as its input grows without bound.","def_ar":"غاية الدالة عند اللانهاية تصف القيمة التي تقترب منها عندما يكبر مدخلها بلا حد.","example":"limₓ→∞ (3x² + 1)/(x² − 5) = 3","status":"needs-check"},
  {"id":"g-calc-081","week":10,"en":"infinite limit","ar":"غاية لا نهائية","def_en":"An infinite limit describes a function whose values grow without bound near an input value.","def_ar":"الغاية اللانهائية تصف دالة تزداد قيمها بلا حد قرب قيمة لمدخلها.","example":"limₓ→₀⁺ 1/x = +∞","status":"needs-check"},
  {"id":"g-calc-082","week":10,"en":"horizontal asymptote","ar":"خط تقارب أفقي","def_en":"A horizontal asymptote is a horizontal line that a graph approaches as x tends to positive or negative infinity.","def_ar":"خط التقارب الأفقي مستقيم أفقي يقترب منه الرسم عندما يتجه x إلى موجب أو سالب اللانهاية.","example":"y = 3 is an asymptote of f(x) = (3x² + 1)/(x² − 5).","status":"needs-check"},
  {"id":"g-calc-083","week":10,"en":"vertical asymptote","ar":"خط تقارب عمودي","def_en":"A vertical asymptote is a vertical line near which function values grow without bound.","def_ar":"خط التقارب العمودي مستقيم عمودي تزداد قربه قيم الدالة بلا حد.","example":"x = 0 is a vertical asymptote of f(x) = 1/x.","status":"needs-check"},
  {"id":"g-calc-084","week":10,"en":"continuous function","ar":"دالة متصلة","def_en":"A function is continuous at a point when its limit there equals its value there.","def_ar":"تكون الدالة متصلة عند نقطة عندما تساوي غايتها عندها قيمتها في تلك النقطة.","example":"If limₓ→ₐ f(x) = f(a), f is continuous at a.","status":"needs-check"},
  {"id":"g-calc-085","week":10,"en":"continuity at a point","ar":"الاتصال عند نقطة","def_en":"Continuity at a point requires the function value and the two-sided limit to exist and be equal.","def_ar":"يتطلب الاتصال عند نقطة وجود قيمة الدالة والغاية الثنائية وتساويهما.","example":"f(a) is defined and limₓ→ₐ f(x) = f(a).","status":"needs-check"},
  {"id":"g-calc-086","week":10,"en":"discontinuous function","ar":"دالة غير متصلة","def_en":"A function is discontinuous at a point when it fails at least one condition for continuity there.","def_ar":"تكون الدالة غير متصلة عند نقطة إذا أخفقت في شرط واحد على الأقل من شروط الاتصال فيها.","example":"A jump in the graph can make the two one-sided limits unequal.","status":"needs-check"},
  {"id":"g-calc-087","week":10,"en":"removable discontinuity","ar":"عدم اتصال قابل للإزالة","def_en":"A removable discontinuity is a hole in a graph where the two-sided limit exists but the function value is missing or different.","def_ar":"عدم الاتصال القابل للإزالة فجوة في الرسم توجد عندها الغاية الثنائية لكن قيمة الدالة مفقودة أو مختلفة.","example":"(x² − 4)/(x − 2) has a removable hole at x = 2.","status":"needs-check"}
]
